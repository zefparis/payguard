# PayGuard production environment variables
# Real values are injected at build time via Codemagic UI
# See: https://docs.codemagic.io/yaml-running-builds/environment-variable-groups/
#
# VITE_API_URL must point to the Vercel proxy (same domain + /api for web,
# or full URL like https://payguard.vercel.app/api for mobile/Capacitor).
# The API key is injected server-side by the Vercel serverless function (HV_API_KEY env var).

VITE_API_URL=/api
VITE_TENANT_ID=payguard-demo

# ── Server-side env vars (Vercel project settings, NOT in client bundle) ──
# Backend Hybrid Vector actif Render
# Ne pas utiliser l'ancien backend Fly.io sauf décision explicite.
PAYGUARD_HV_API_URL=https://hybrid-vector-api-m5xt.onrender.com
# API key for hybrid-vector-api (server-side only)
HV_API_KEY=your-hv-api-key-here
# CORS allowlist (comma-separated origins)
PAYGUARD_ALLOWED_ORIGINS=https://payguard.vercel.app,capacitor://localhost,https://localhost
# Server-side tenant override (replaces client-supplied tenant_id)
PAYGUARD_TENANT_ID=payguard-demo
# Rate limit per IP per minute (0 = disabled)
PAYGUARD_PROXY_RATE_LIMIT_PER_MIN=60
